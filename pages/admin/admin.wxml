<view class="page">
  <view class="section">
    <text class="section-title">待审核词条</text>
    <view class="related-tags">
      <view class="related-tag tag tag--primary" bindtap="onGenerateAllTap">生成草稿</view>
      <view class="related-tag tag tag--secondary" bindtap="onExportTap">导出知识库</view>
    </view>
  </view>

  <view class="section" wx:if="{{items.length === 0}}">
    <view class="explanation-card glass-card">
      <text class="explanation-text">暂无待审核词条</text>
    </view>
  </view>

  <view class="section" wx:for="{{items}}" wx:key="id">
    <view class="explanation-card glass-card">
      <text class="section-title">{{item.keyword}}</text>
      <text class="tag tag--secondary">{{item.status}}</text>

      <view wx:if="{{item.draft && !item.isEditing}}">
        <text class="explanation-text">{{item.draft.summary}}</text>
        <text class="analogy-text">{{item.draft.analogy}}</text>
      </view>

      <textarea
        wx:if="{{item.isEditing}}"
        value="{{item.draftText}}"
        data-id="{{item.id}}"
        bindinput="onDraftInput"
        auto-height
      />

      <view class="related-tags">
        <view class="related-tag tag tag--primary" bindtap="onApproveTap" data-id="{{item.id}}">通过</view>
        <view class="related-tag tag tag--secondary" bindtap="onEditTap" data-id="{{item.id}}">
          {{item.isEditing ? '保存修改' : '修改'}}
        </view>
        <view class="related-tag tag tag--secondary" bindtap="onDeleteTap" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
