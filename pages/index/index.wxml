<!--pages/index/index.wxml - 清新极简风格 -->
<view class="page">
  <view class="header">
    <text class="large-title">AI大白话</text>
    <text class="subtitle">让复杂的AI术语，变得通俗易懂</text>
  </view>

  <view class="search-section">
    <view class="search-box card">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="输入不懂的AI术语..."
        value="{{searchText}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
        focus="{{autoFocus}}"
      />
    </view>
  </view>

  <view class="quick-search" wx:if="{{searchText.length > 0}}">
    <button class="quick-search-btn btn-primary" bindtap="onSearch">
      开始翻译
    </button>
  </view>

  <view class="featured-section" wx:if="{{searchText.length === 0}}">
    <view class="featured-card card" bindtap="onDailyWordTap">
      <text class="featured-badge">✨ 今日一词</text>
      <text class="featured-word">{{dailyWord.term}}</text>
      <text class="featured-desc">{{dailyWord.shortDesc}}</text>
      <text class="featured-action">点击了解详情 →</text>
    </view>
  </view>

  <view class="hot-section" wx:if="{{searchText.length === 0}}">
    <text class="section-title">🔥 热门词汇</text>
    <view class="hot-tags">
      <view 
        class="hot-tag tag tag-primary" 
        wx:for="{{hotTerms}}" 
        wx:key="*this"
        bindtap="onHotTermTap"
        data-term="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </view>

  <view class="features-section" wx:if="{{searchText.length === 0}}">
    <text class="section-title">💡 快速入口</text>
    <view class="feature-grid">
      <view class="feature-item card" bindtap="onGoDictionary">
        <text class="feature-icon">📚</text>
        <text class="feature-name">我的词库</text>
      </view>
      <view class="feature-item card" bindtap="onGoHistory">
        <text class="feature-icon">🕐</text>
        <text class="feature-name">搜索历史</text>
      </view>
      <view class="feature-item card" bindtap="onGoMine">
        <text class="feature-icon">📊</text>
        <text class="feature-name">学习进度</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
