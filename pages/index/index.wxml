<!--pages/index/index.wxml - 手绘笔记风格 -->
<view class="page page-content">
  <!-- 头部标题区域 -->
  <view class="header">
    <text class="marker-title">AI大白话</text>
    <text class="subtitle">用笔记的方式，看懂复杂的AI术语 📝</text>
  </view>

  <!-- 搜索框 - 笔记本风格 -->
  <view class="search-section">
    <view class="search-box sticky-note sticky-yellow">
      <view class="tape tape-top"></view>
      <view class="search-icon-wrapper">
        <text class="search-icon">🔍</text>
      </view>
      <input 
        class="search-input notebook-input"
        placeholder="输入不懂的AI术语..."
        value="{{searchText}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
        focus="{{autoFocus}}"
      />
    </view>
  </view>

  <!-- 搜索按钮 -->
  <view class="search-btn-wrapper" wx:if="{{searchText.length > 0}}">
    <button class="btn-marker" bindtap="onSearch">
      ✏️ 开始翻译
    </button>
  </view>

  <!-- 每日一词 - 便签卡片 -->
  <view class="featured-section" wx:if="{{searchText.length === 0}}">
    <view class="section-header">
      <text class="section-title">今日一词</text>
    </view>
    <view class="featured-card sticky-note sticky-blue" bindtap="onDailyWordTap">
      <view class="tape tape-corner"></view>
      <view class="featured-badge">
        <text class="badge-icon">⭐</text>
        <text class="badge-text">推荐学习</text>
      </view>
      <text class="featured-word">{{dailyWord.term}}</text>
      <text class="featured-desc">{{dailyWord.shortDesc}}</text>
      <view class="featured-footer">
        <text class="featured-hint">点击查看详细笔记 →</text>
      </view>
    </view>
  </view>

  <!-- 热门词汇 - 标签云 -->
  <view class="hot-section" wx:if="{{searchText.length === 0}}">
    <view class="section-header">
      <text class="section-title">大家都在查</text>
    </view>
    <view class="hot-tags">
      <view 
        class="tag tag-yellow" 
        wx:for="{{hotTerms}}" 
        wx:key="*this"
        bindtap="onHotTermTap"
        data-term="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </view>

  <!-- 功能入口 - 便签网格 -->
  <view class="features-section" wx:if="{{searchText.length === 0}}">
    <view class="section-header">
      <text class="section-title">我的笔记</text>
    </view>
    <view class="feature-grid">
      <view class="feature-item sticky-note sticky-green" bindtap="onGoDictionary">
        <view class="feature-icon icon-sticker icon-green">📚</view>
        <text class="feature-name">我的词库</text>
        <text class="feature-count">{{dictCount}} 个词汇</text>
      </view>
      <view class="feature-item sticky-note sticky-pink" bindtap="onGoHistory">
        <view class="feature-icon icon-sticker icon-pink">🕐</view>
        <text class="feature-name">搜索历史</text>
        <text class="feature-count">{{historyCount}} 次查询</text>
      </view>
      <view class="feature-item sticky-note sticky-purple" bindtap="onGoMine">
        <view class="feature-icon icon-sticker icon-purple">📊</view>
        <text class="feature-name">学习进度</text>
        <text class="feature-count">{{learnPercent}}% 完成</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-spacer"></view>
</view>
