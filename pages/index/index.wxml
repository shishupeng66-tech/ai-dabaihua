<!--pages/index/index.wxml - SaaS Landing Page -->
<view class="page">
  <view class="hero">
    <text class="brand-name">AI大白话</text>
    <text class="brand-subtitle">用人话解释AI，让每个人都能看懂</text>
  </view>

  <view class="search-panel">
    <view class="search-box">
      <textarea
        class="term-input"
        placeholder="输入你想了解的AI术语，例如 Token、API、Agent"
        value="{{searchText}}"
        bindinput="onSearchInput"
        maxlength="120"
        auto-height="{{false}}"
      />
    </view>

    <button class="explain-button" bindtap="onSearch">
      开始解释
    </button>
  </view>

  <view class="hot-section">
    <text class="hot-title">大家都在搜索：</text>
    <view class="hot-tags">
      <view
        class="hot-tag"
        wx:for="{{hotTerms}}"
        wx:key="*this"
        bindtap="onHotTermTap"
        data-term="{{item}}"
      >
        {{item}}
      </view>
    </view>
  </view>
</view>
