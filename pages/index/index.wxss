/* 首页样式 - SaaS Landing Page */

.page {
  min-height: 100vh;
  padding: 96rpx 44rpx 64rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #F5F7FF 0%, #FFFFFF 58%, #F8FAFF 100%);
}

.hero {
  margin-top: 48rpx;
  margin-bottom: 72rpx;
}

.brand-name {
  display: block;
  font-size: 76rpx;
  line-height: 1.08;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: 0;
  margin-bottom: 24rpx;
}

.brand-subtitle {
  display: block;
  max-width: 600rpx;
  font-size: 34rpx;
  line-height: 1.45;
  color: #5F6368;
  font-weight: 400;
}

.search-panel {
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow:
    0 20rpx 60rpx rgba(26, 36, 64, 0.08),
    0 4rpx 16rpx rgba(26, 36, 64, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  margin-bottom: 44rpx;
}

.search-box {
  min-height: 180rpx;
  padding: 24rpx 24rpx 18rpx;
  border-radius: 24rpx;
  background: #F7F9FC;
  border: 1rpx solid rgba(29, 29, 31, 0.06);
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.term-input {
  width: 100%;
  height: 136rpx;
  font-size: 31rpx;
  line-height: 1.5;
  color: #1D1D1F;
  font-weight: 500;
}

.term-input::placeholder {
  color: #9AA0A6;
  font-weight: 400;
}

.explain-button {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 24rpx;
  border: none;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(0, 122, 255, 0.22);
}

.explain-button::after {
  border: none;
}

.explain-button:active {
  background: #0067D8;
  transform: scale(0.99);
}

.hot-section {
  margin-top: 8rpx;
}

.hot-title {
  display: block;
  font-size: 28rpx;
  color: #6E737A;
  margin-bottom: 22rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.hot-tag {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 600;
}

.hot-tag:active {
  background: rgba(0, 122, 255, 0.16);
  transform: scale(0.97);
}
