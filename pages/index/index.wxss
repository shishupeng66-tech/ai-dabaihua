/* 首页样式 - 清新极简风格 */

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

/* 头部区域 */
.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.large-title {
  font-size: 60rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #1E293B 0%, #6366F1 50%, #8B5CF6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: -1.5rpx;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 400;
}

/* 搜索区域 */
.search-section {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1E293B;
  font-weight: 500;
}

.search-input::placeholder {
  color: #94A3B8;
}

/* 快速搜索按钮 */
.quick-search {
  margin-bottom: 32rpx;
}

.quick-search-btn {
  width: 100%;
  padding: 28rpx;
  font-size: 32rpx;
  border-radius: 20rpx;
}

/* 每日一词 */
.featured-section {
  margin-bottom: 36rpx;
}

.featured-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 32rpx;
  color: #FFFFFF;
}

.featured-badge {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  opacity: 0.95;
}

.featured-word {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.featured-desc {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.featured-action {
  font-size: 26rpx;
  opacity: 0.85;
  font-weight: 500;
}

/* 热门词汇 */
.hot-section {
  margin-bottom: 36rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 功能入口 */
.features-section {
  margin-bottom: 36rpx;
}

.feature-grid {
  display: flex;
  gap: 16rpx;
}

.feature-item {
  flex: 1;
  padding: 28rpx 16rpx;
  text-align: center;
}

.feature-icon {
  display: block;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #1E293B;
  font-weight: 600;
}

.feature-item:active {
  transform: translateY(-4rpx);
}

/* 底部留白 */
.bottom-spacer {
  height: 120rpx;
}
