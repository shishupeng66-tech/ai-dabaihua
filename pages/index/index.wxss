/* 首页样式 - SaaS Product Home */

.page {
  min-height: 100vh;
  padding: 54rpx 42rpx 52rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 10%, rgba(255, 184, 64, 0.18) 0%, rgba(255, 184, 64, 0) 34%),
    linear-gradient(180deg, #FFF8F1 0%, #FFFDF8 42%, #FFFFFF 100%);
  color: #1F1F1F;
}

.hero-section {
  padding-top: 24rpx;
}

.hero-copy {
  text-align: center;
  margin-bottom: 16rpx;
}

.brand-title {
  display: block;
  font-size: 76rpx;
  line-height: 1.08;
  font-weight: 800;
  color: #1F1F1F;
  letter-spacing: 0;
  margin-bottom: 18rpx;
}

.brand-subtitle {
  display: block;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 500;
  color: #6B6B6B;
}

.hero-visual {
  height: 396rpx;
  margin: 34rpx -4rpx 0;
  position: relative;
}

.hero-visual::before {
  content: '';
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  bottom: 34rpx;
  height: 84rpx;
  border-radius: 50%;
  background: rgba(255, 184, 64, 0.14);
  filter: blur(14rpx);
}

.hero-asset {
  position: absolute;
  display: block;
}

.hero-woman {
  width: 196rpx;
  left: 76rpx;
  bottom: 42rpx;
  z-index: 2;
}

.hero-robot {
  width: 174rpx;
  right: 88rpx;
  bottom: 44rpx;
  z-index: 2;
}

.hero-bubble-orange {
  width: 126rpx;
  left: 280rpx;
  top: 94rpx;
  z-index: 3;
}

.hero-shelf {
  width: 104rpx;
  left: 32rpx;
  bottom: 98rpx;
  z-index: 1;
}

.hero-coffee {
  width: 68rpx;
  left: 336rpx;
  bottom: 44rpx;
  z-index: 3;
}

.input-card {
  margin-top: 16rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(241, 230, 214, 0.9);
  box-shadow:
    0 28rpx 72rpx rgba(126, 82, 23, 0.11),
    0 6rpx 18rpx rgba(126, 82, 23, 0.06);
}

.textarea-wrap {
  min-height: 220rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
  border: 1rpx solid #F1E6D6;
  box-sizing: border-box;
  position: relative;
  margin-bottom: 28rpx;
}

.term-input {
  width: 100%;
  height: 158rpx;
  font-size: 31rpx;
  line-height: 1.48;
  color: #1F1F1F;
  font-weight: 500;
}

.term-input::placeholder {
  color: #A0A0A0;
  font-weight: 400;
}

.input-count {
  position: absolute;
  right: 26rpx;
  bottom: 18rpx;
  font-size: 24rpx;
  color: #A0A0A0;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 34rpx;
  border: none;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #FF8A00 0%, #FFB040 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 34rpx rgba(255, 138, 0, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.primary-button::after {
  border: none;
}

.primary-button:active {
  transform: scale(0.985);
  box-shadow: 0 10rpx 24rpx rgba(255, 138, 0, 0.22);
}

.button-spark {
  font-size: 32rpx;
  line-height: 1;
}

.hot-section {
  padding: 42rpx 2rpx 0;
}

.hot-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.hot-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1F1F;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 20rpx;
}

.hot-tag {
  min-width: 120rpx;
  padding: 18rpx 28rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #FFF3E0;
  border: 1rpx solid rgba(255, 138, 0, 0.08);
  color: #8A4B00;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(126, 82, 23, 0.04);
}

.hot-tag:active {
  background: #FFE8C0;
  transform: scale(0.97);
}

.footer-note {
  margin-top: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #B4A992;
  font-size: 24rpx;
}

.footer-dot {
  margin-right: 10rpx;
  font-size: 28rpx;
}
