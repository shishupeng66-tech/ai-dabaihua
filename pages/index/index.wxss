/* 首页样式 - 手绘笔记风格 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部区域 */
.header {
  margin-bottom: 36rpx;
  text-align: center;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
}

/* 搜索区域 */
.search-section {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  position: relative;
}

.search-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
}

/* 搜索按钮 */
.search-btn-wrapper {
  margin-bottom: 32rpx;
  text-align: center;
}

/* 每日一词 */
.featured-section {
  margin-bottom: 36rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.featured-card {
  padding: 32rpx 28rpx;
  position: relative;
  transform: rotate(-0.5deg);
}

.featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 4rpx;
  margin-bottom: 20rpx;
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 20rpx;
  color: #01579B;
  font-weight: 600;
}

.featured-word {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #01579B;
  margin-bottom: 12rpx;
}

.featured-desc {
  display: block;
  font-size: 26rpx;
  color: #2D2D2D;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.featured-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.featured-hint {
  font-size: 22rpx;
  color: #0288D1;
  font-style: italic;
  font-weight: 500;
}

/* 热门词汇 */
.hot-section {
  margin-bottom: 36rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 功能入口 */
.features-section {
  margin-bottom: 36rpx;
}

.feature-grid {
  display: flex;
  gap: 16rpx;
}

.feature-item {
  flex: 1;
  padding: 28rpx 16rpx;
  text-align: center;
}

.feature-item:nth-child(1) {
  transform: rotate(1deg);
}

.feature-item:nth-child(2) {
  transform: rotate(-0.8deg);
}

.feature-item:nth-child(3) {
  transform: rotate(0.5deg);
}

.feature-icon {
  margin: 0 auto 16rpx;
}

.feature-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 6rpx;
}

.feature-count {
  font-size: 22rpx;
  color: #8D6E63;
  font-style: italic;
}

/* 底部留白 */
.bottom-spacer {
  height: 120rpx;
}
