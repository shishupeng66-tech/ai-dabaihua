/* 首页样式 - Apple 设计风格 · 增强版 */

.page {
  min-height: 100vh;
  padding: 70rpx 44rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 头部区域 - 居中布局 ============== */
.header {
  text-align: center;
  margin-bottom: 64rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.large-title {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -2rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 32rpx;
  color: #86868B;
  font-weight: 400;
  letter-spacing: -0.3rpx;
}

/* ============== 搜索区域 - 增强版 ============== */
.search-section {
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s both;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.search-box:active {
  transform: scale(0.985);
}

.search-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 32rpx;
  color: #1D1D1F;
  font-weight: 500;
  letter-spacing: -0.3rpx;
}

.search-input::placeholder {
  color: #C7C7CC;
}

/* ============== 搜索按钮 ============== */
.search-btn-container {
  margin-bottom: 48rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s both;
}

.search-btn-container .btn-primary {
  width: 100%;
}

/* ============== 内容区域 ============== */
.content-area {
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s both;
}

.section-title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 28rpx;
  letter-spacing: -0.6rpx;
}

/* ============== 每日一词卡片 - 增强版 ============== */
.featured-section {
  margin-bottom: 56rpx;
}

.featured-card {
  padding: 40rpx 36rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.featured-card:active {
  transform: scale(0.975) translateY(4rpx);
  box-shadow: 
    0 12rpx 40rpx rgba(0, 0, 0, 0.05),
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, rgba(0,122,255,0.12) 0%, rgba(88,86,214,0.12) 100%);
  border-radius: 100rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.1);
}

.badge-icon {
  font-size: 22rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #007AFF;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.featured-word {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16rpx;
  letter-spacing: -0.8rpx;
}

.featured-desc {
  display: block;
  font-size: 30rpx;
  color: #86868B;
  line-height: 1.6;
  margin-bottom: 28rpx;
  letter-spacing: -0.2rpx;
}

.featured-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.featured-action {
  font-size: 28rpx;
  color: #007AFF;
  font-weight: 500;
}

.featured-arrow {
  font-size: 32rpx;
  color: #007AFF;
  font-weight: 400;
}

/* ============== 热门词汇标签 - 增强版 ============== */
.hot-section {
  margin-bottom: 56rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: -0.2rpx;
}

.hot-tag:active {
  transform: scale(0.94);
  background: rgba(0, 122, 255, 0.15);
}

/* ============== 功能入口网格 - 增强版 ============== */
.features-section {
  margin-bottom: 48rpx;
}

.feature-grid {
  display: flex;
  gap: 20rpx;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 20rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.feature-item:active {
  transform: scale(0.94);
}

.feature-icon {
  margin-bottom: 20rpx;
}

.feature-name {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
  letter-spacing: -0.2rpx;
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 140rpx;
}
