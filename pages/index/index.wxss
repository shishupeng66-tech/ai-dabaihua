/* 首页样式 - Apple 设计风格 */

.page {
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 头部区域 ============== */
.header {
  text-align: center;
  margin-bottom: 56rpx;
}

.large-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -1rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  color: #86868B;
  font-weight: 400;
}

/* ============== 搜索区域 ============== */
.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.search-input::placeholder {
  color: #C7C7CC;
}

/* ============== 搜索按钮 ============== */
.search-btn-container {
  margin-bottom: 40rpx;
}

.search-btn-container .btn-primary {
  width: 100%;
}

/* ============== 内容区域 ============== */
.content-area {
  animation: fadeIn 0.5s ease 0.1s both;
}

.section-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  letter-spacing: -0.3rpx;
}

/* ============== 每日一词卡片 ============== */
.featured-section {
  margin-bottom: 48rpx;
}

.featured-card {
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.featured-card:active {
  transform: scale(0.985);
  box-shadow: 
    0 2rpx 12rpx rgba(0, 0, 0, 0.06),
    0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.featured-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(0, 122, 255, 0.12);
  border-radius: 100rpx;
  margin-bottom: 24rpx;
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #007AFF;
  font-weight: 500;
}

.featured-word {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  letter-spacing: -0.3rpx;
}

.featured-desc {
  display: block;
  font-size: 28rpx;
  color: #86868B;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.featured-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.featured-action {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 500;
}

.featured-arrow {
  font-size: 28rpx;
  color: #007AFF;
}

/* ============== 热门词汇 ============== */
.hot-section {
  margin-bottom: 48rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hot-tag {
  padding: 14rpx 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* ============== 功能入口 ============== */
.features-section {
  margin-bottom: 40rpx;
}

.feature-grid {
  display: flex;
  gap: 16rpx;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  transition: all 0.3s ease;
}

.feature-item:active {
  transform: scale(0.96);
}

.feature-icon {
  margin-bottom: 16rpx;
}

.feature-name {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 500;
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 120rpx;
}
