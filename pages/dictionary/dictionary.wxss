/* 词典页面样式 - 手绘笔记风格 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 头部 */
.header {
  margin-bottom: 28rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
}

/* 搜索框 */
.search-section {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

/* 分类标签 */
.category-section {
  margin-bottom: 28rpx;
}

.tabs-scroll {
  white-space: nowrap;
  margin: 0 -16rpx;
  padding: 0 16rpx;
}

.tabs-wrapper {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 16rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
}

.tab-icon {
  font-size: 20rpx;
}

.tab-name {
  font-size: 24rpx;
  font-weight: 600;
}

/* 词汇列表 */
.word-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.word-card {
  padding: 24rpx;
  position: relative;
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.word-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2D2D;
}

.word-tag {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
}

.word-preview {
  margin-bottom: 16rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #5D4037;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.word-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.word-date {
  font-size: 22rpx;
  color: #8D6E63;
  font-style: italic;
}

.review-status {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.review-icon {
  font-size: 20rpx;
}

.review-text {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 500;
}

/* 空状态 */
.empty-btn {
  margin-top: 24rpx;
}

/* 底部留白 */
.bottom-spacer {
  height: 120rpx;
}
