/* 词库页样式 - Apple 设计风格 · 增强版 */

.page {
  min-height: 100vh;
  padding: 60rpx 44rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 头部统计 ============== */
.header {
  margin-bottom: 48rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.large-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #86868B;
  letter-spacing: -0.2rpx;
}

/* ============== 搜索框 ============== */
.search-section {
  margin-bottom: 36rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s both;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  transition: all 0.4s ease;
}

.search-box:active {
  transform: scale(0.985);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  letter-spacing: -0.2rpx;
}

.search-input::placeholder {
  color: #C7C7CC;
}

/* ============== 分类标签滚动 ============== */
.category-section {
  margin-bottom: 40rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s both;
}

.tabs-scroll {
  white-space: nowrap;
  margin: 0 -44rpx;
  padding: 0 44rpx;
}

.tabs-wrapper {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 44rpx;
}

.tab-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
}

.tab-item:active {
  transform: scale(0.95);
}

/* ============== 词汇卡片列表 ============== */
.word-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s both;
}

.word-card {
  padding: 32rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.word-card:active {
  transform: scale(0.98);
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.word-name {
  font-size: 36rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.5rpx;
}

.word-category {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}

.word-preview {
  font-size: 28rpx;
  color: #86868B;
  line-height: 1.6;
  letter-spacing: -0.2rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============== 空状态 - 增强版 ============== */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
  animation: scaleInSoft 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.empty-icon {
  display: block;
  font-size: 96rpx;
  margin-bottom: 32rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.empty-subtitle {
  display: block;
  font-size: 28rpx;
  color: #86868B;
  margin-bottom: 48rpx;
  letter-spacing: -0.2rpx;
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 140rpx;
}
