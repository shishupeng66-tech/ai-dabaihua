/* 词库页样式 - Apple 设计风格 */

.page {
  min-height: 100vh;
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 头部 ============== */
.header {
  margin-bottom: 40rpx;
}

.large-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #86868B;
}

/* ============== 搜索框 ============== */
.search-section {
  margin-bottom: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D1D1F;
}

.search-input::placeholder {
  color: #C7C7CC;
}

/* ============== 分类标签 ============== */
.category-section {
  margin-bottom: 32rpx;
}

.tabs-scroll {
  white-space: nowrap;
  margin: 0 -40rpx;
  padding: 0 40rpx;
}

.tabs-wrapper {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 40rpx;
}

.tab-item {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}

/* ============== 词汇列表 ============== */
.word-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.word-card {
  padding: 28rpx;
  transition: all 0.3s ease;
}

.word-card:active {
  transform: scale(0.985);
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.word-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.word-category {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.word-preview {
  font-size: 26rpx;
  color: #86868B;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============== 空状态 ============== */
.empty-state {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  display: block;
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 40rpx;
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 120rpx;
}
