/* 词典页面样式 - 清新极简风格 */

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

.header {
  margin-bottom: 32rpx;
}

.large-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #1E293B;
  margin-bottom: 8rpx;
  letter-spacing: -0.5rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #64748B;
}

.search-section {
  margin-bottom: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

.search-input::placeholder {
  color: #94A3B8;
}

.category-section {
  margin-bottom: 28rpx;
}

.tabs-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.tabs-wrapper {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 32rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.word-card {
  padding: 28rpx;
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.word-name {
  font-size: 32rpx;
  color: #1E293B;
  font-weight: 700;
}

.word-preview {
  margin-bottom: 0;
}

.preview-text {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-state {
  padding: 120rpx 40rpx;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 22rpx 48rpx;
  font-size: 28rpx;
}

.bottom-spacer {
  height: 120rpx;
}
