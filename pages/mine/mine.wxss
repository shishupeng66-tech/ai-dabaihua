/* 个人中心样式 - Apple 设计风格 · 增强版 */

.page {
  min-height: 100vh;
  padding: 60rpx 44rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 用户信息卡片 ============== */
.profile-card {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  margin-bottom: 36rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.avatar-wrapper {
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #007AFF25 0%, #5856D625 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.15);
  position: relative;
}

.avatar-wrapper::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255,255,255,0.4);
}

.avatar-emoji {
  font-size: 56rpx;
}

.profile-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  letter-spacing: -0.5rpx;
}

.user-level {
  font-size: 28rpx;
  color: #86868B;
  font-weight: 500;
  letter-spacing: -0.2rpx;
}

/* ============== 统计数据卡片 ============== */
.stats-section {
  margin-bottom: 48rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s both;
}

.stats-card {
  padding: 40rpx 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #007AFF 0%, #34C759 50%, #5856D6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #86868B;
  letter-spacing: -0.2rpx;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: linear-gradient(180deg, 
    rgba(0,0,0,0) 0%, 
    rgba(0,0,0,0.06) 50%, 
    rgba(0,0,0,0) 100%);
}

/* ============== 功能菜单 ============== */
.menu-section {
  margin-bottom: 56rpx;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.15s both;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  letter-spacing: -0.6rpx;
}

.menu-card {
  padding: 8rpx 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  transition: all 0.2s ease;
}

.menu-item:active {
  background: rgba(0, 0, 0, 0.025);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.menu-emoji {
  font-size: 30rpx;
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  color: #1D1D1F;
  font-weight: 500;
  letter-spacing: -0.3rpx;
}

.menu-count {
  margin-right: 20rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  font-weight: 300;
}

/* ============== 页脚 ============== */
.footer {
  text-align: center;
  padding: 24rpx 0;
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s both;
}

.version-text {
  font-size: 26rpx;
  color: #C7C7CC;
  letter-spacing: 1rpx;
}
