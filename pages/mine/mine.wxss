/* 个人中心样式 - 清新极简风格 */

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  animation: fadeIn 0.4s ease;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.avatar-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.avatar-emoji {
  font-size: 44rpx;
}

.profile-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 34rpx;
  color: #1E293B;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.user-level {
  font-size: 26rpx;
  color: #6366F1;
  font-weight: 500;
}

.stats-section {
  margin-bottom: 32rpx;
}

.stats-card {
  padding: 28rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #64748B;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #E2E8F0;
}

.menu-section {
  margin-bottom: 32rpx;
}

.menu-card {
  padding: 8rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  transition: all 0.2s ease;
}

.menu-item:active {
  background: #F8FAFC;
}

.menu-icon {
  font-size: 28rpx;
  margin-right: 20rpx;
  width: 36rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

.menu-count {
  margin-right: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
  font-weight: 500;
}

.menu-divider {
  height: 1rpx;
  background: #F1F5F9;
  margin: 0 28rpx;
}

.footer {
  text-align: center;
  padding: 40rpx 0 120rpx;
}

.version-text {
  font-size: 24rpx;
  color: #94A3B8;
}
