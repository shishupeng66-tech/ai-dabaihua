/* 个人中心样式 - 多彩现代风格 */

.page {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  animation: fadeInUp 0.5s ease;
}

/* 用户信息卡片 */
.profile-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
}

.avatar-emoji {
  font-size: 44rpx;
}

.profile-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 34rpx;
  color: #1A1A2E;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.level-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.level-badge {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.level-name {
  font-size: 24rpx;
  color: #6B6B8A;
  font-weight: 500;
}

.streak-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 142, 83, 0.08) 100%);
  border-radius: 16rpx;
}

.streak-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.streak-text {
  font-size: 22rpx;
  color: #FF6B6B;
  font-weight: 700;
}

/* 学习统计卡片 */
.stats-section {
  margin-bottom: 28rpx;
}

.stats-card {
  padding: 28rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 28rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8A8AAA;
}

/* 进度条 */
.progress-wrapper {
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F5FA;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #6B6B8A;
}

.progress-value {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 700;
}

.progress-bar {
  height: 12rpx;
  background: #F5F5FA;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B6B 0%, #FF8E53 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-hint {
  font-size: 22rpx;
  color: #A0A0B8;
}

/* 成就区域 */
.achievements-section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  color: #1A1A2E;
  font-weight: 700;
}

.achievements-card {
  padding: 8rpx 0;
}

.achievement-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  transition: all 0.2s ease;
}

.achievement-item:active {
  background: #FAFAFA;
}

.achievement-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 18rpx;
}

.achievement-info {
  flex: 1;
}

.achievement-name {
  display: block;
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.achievement-desc {
  display: block;
  font-size: 22rpx;
  color: #8A8AAA;
}

.achievement-status {
  font-size: 28rpx;
}

.achievement-status.unlocked {
  color: #2EAEA5;
  font-weight: 800;
}

.achievement-status.locked {
  opacity: 0.5;
}

/* 功能菜单 */
.menu-section {
  margin-bottom: 28rpx;
}

.menu-card {
  padding: 8rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  transition: all 0.2s ease;
}

.menu-item:active {
  background: #FAFAFA;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 18rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: 500;
}

.menu-count {
  margin-right: 12rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C0C0D0;
  font-weight: 500;
}

.menu-divider {
  height: 1rpx;
  background: #F5F5FA;
  margin: 0 28rpx;
}

/* 底部版本 */
.footer {
  text-align: center;
  padding: 40rpx 0 120rpx;
}

.version-text {
  display: block;
  font-size: 24rpx;
  color: #A0A0B8;
  margin-bottom: 8rpx;
}

.made-with-love {
  display: block;
  font-size: 22rpx;
  color: #C0C0D0;
}
