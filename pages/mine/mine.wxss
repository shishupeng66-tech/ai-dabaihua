/* 个人中心样式 - Apple 设计风格 */

.page {
  min-height: 100vh;
  padding: 50rpx 40rpx 40rpx;
  box-sizing: border-box;
}

/* ============== 用户信息卡片 ============== */
.profile-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  margin-bottom: 32rpx;
}

.avatar-wrapper {
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #007AFF15 0%, #5856D615 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-emoji {
  font-size: 52rpx;
}

.profile-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 6rpx;
}

.user-level {
  font-size: 26rpx;
  color: #86868B;
  font-weight: 500;
}

/* ============== 统计数据 ============== */
.stats-section {
  margin-bottom: 40rpx;
}

.stats-card {
  padding: 36rpx 20rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #86868B;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* ============== 功能菜单 ============== */
.menu-section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20rpx;
}

.menu-card {
  padding: 8rpx 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  transition: background 0.2s ease;
}

.menu-item:active {
  background: rgba(0, 0, 0, 0.03);
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-emoji {
  font-size: 26rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.menu-count {
  margin-right: 16rpx;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  font-weight: 400;
}

/* ============== 页脚 ============== */
.footer {
  text-align: center;
  padding: 20rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #C7C7CC;
}
