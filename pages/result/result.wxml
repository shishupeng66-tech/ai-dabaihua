<!--pages/result/result.wxml - 手绘笔记风格 -->
<view class="page page-content">
  <!-- 加载状态 -->
  <view class="loading-doodle" wx:if="{{isLoading}}">
    <text class="loading-pencil">✏️</text>
    <text class="loading-text">正在写笔记...</text>
  </view>

  <!-- 结果内容 -->
  <view class="result-content" wx:if="{{!isLoading && resultData}}">
    <!-- 术语标题 -->
    <view class="term-header">
      <text class="marker-title">{{resultData.term}}</text>
      <view class="term-actions">
        <view class="action-btn icon-sticker icon-yellow {{isFavorite ? 'favorited' : ''}}" bindtap="onFavoriteTap">
          {{isFavorite ? '❤️' : '🤍'}}
        </view>
        <view class="action-btn icon-sticker icon-blue" bindtap="onCopyTap">📋</view>
      </view>
    </view>

    <!-- 大白话解释 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">💡 大白话解释</text>
      </view>
      <view class="explanation-card sticky-note sticky-yellow">
        <view class="tape tape-corner"></view>
        <text class="explanation-text">{{resultData.explanation}}</text>
      </view>
    </view>

    <!-- 类比说明 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">🎯 打个比方</text>
      </view>
      <view class="analogy-card sticky-note sticky-green">
        <text class="analogy-icon">{{resultData.analogyIcon}}</text>
        <text class="analogy-text">{{resultData.analogy}}</text>
      </view>
    </view>

    <!-- 举例子 -->
    <view class="section" wx:if="{{resultData.examples && resultData.examples.length > 0}}">
      <view class="section-header">
        <text class="section-title">📝 举个栗子</text>
      </view>
      <view class="examples-card sticky-note sticky-blue">
        <view class="tape tape-top"></view>
        <view 
          class="example-item" 
          wx:for="{{resultData.examples}}" 
          wx:key="*this"
        >
          <view class="example-number">{{index + 1}}</view>
          <text class="example-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 相关词汇 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">🔗 相关笔记</text>
      </view>
      <view class="related-tags">
        <view 
          class="tag tag-pink" 
          wx:for="{{relatedTerms}}" 
          wx:key="*this"
          bindtap="onRelatedTap"
          data-term="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-spacer"></view>
  </view>
</view>
