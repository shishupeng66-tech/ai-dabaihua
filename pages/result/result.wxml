<!--pages/result/result.wxml - Apple 设计风格 -->
<view class="page">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在翻译中...</text>
  </view>

  <view class="loading-container" wx:if="{{!isLoading && errorText}}">
    <text class="loading-text">{{errorText}}</text>
  </view>

  <!-- 结果内容 -->
  <view class="result-content fade-in" wx:if="{{!isLoading && resultData}}">
    
    <!-- 术语标题 -->
    <view class="term-header">
      <view>
        <text class="term-title">{{resultData.term}}是什么？</text>
        <text class="tag tag--secondary">{{sourceText}}</text>
      </view>
      <view class="term-actions">
        <view class="action-btn btn-secondary" bindtap="onFavoriteTap">
          {{isFavorite ? '❤️' : '🤍'}}
        </view>
        <view class="action-btn btn-secondary" bindtap="onCopyTap">📋</view>
      </view>
    </view>

    <!-- 一句话解释 -->
    <view class="section">
      <text class="section-title">一句话</text>
      <view class="explanation-card glass-card">
        <text class="explanation-text">{{resultData.summary || resultData.explanation}}</text>
      </view>
    </view>

    <!-- 生活例子 -->
    <view class="section">
      <text class="section-title">生活例子</text>
      <view class="analogy-card glass-card">
        <text class="analogy-text">{{resultData.analogy}}</text>
      </view>
    </view>

    <!-- 示例 -->
    <view class="section" wx:if="{{resultData.examples && resultData.examples.length > 0}}">
      <text class="section-title">举个例子</text>
      <view class="examples-card glass-card">
        <view 
          class="example-item" 
          wx:for="{{resultData.examples}}" 
          wx:key="*this"
        >
          <view class="example-number">{{index + 1}}</view>
          <text class="example-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 为什么重要 -->
    <view class="section" wx:if="{{resultData.usage}}">
      <text class="section-title">为什么重要</text>
      <view class="explanation-card glass-card">
        <text class="explanation-text">{{resultData.usage}}</text>
      </view>
    </view>

    <!-- 反馈 -->
    <view class="section">
      <view class="related-tags">
        <view class="related-tag tag tag--primary" bindtap="onHelpfulTap">
          👍 解释有帮助
        </view>
        <view class="related-tag tag tag--secondary" bindtap="onReExplainTap">
          🔄 重新解释
        </view>
      </view>
    </view>

    <!-- 相关词汇 -->
    <view class="section">
      <text class="section-title">相关词汇</text>
      <view class="related-tags">
        <view 
          class="related-tag tag tag--secondary" 
          wx:for="{{relatedTerms}}" 
          wx:key="*this"
          bindtap="onRelatedTap"
          data-term="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

  </view>

  <view class="bottom-spacer"></view>
</view>
