<!--pages/result/result.wxml - 清新极简风格 -->
<view class="page">
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在翻译...</text>
  </view>

  <view class="result-content" wx:if="{{!isLoading && resultData}}">
    <view class="term-header">
      <text class="term-title">{{resultData.term}}</text>
      <view class="term-actions">
        <view class="action-btn btn-secondary" bindtap="onFavoriteTap">
          {{isFavorite ? '❤️' : '🤍'}}
        </view>
        <view class="action-btn btn-secondary" bindtap="onCopyTap">📋</view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">💡 大白话解释</text>
      <view class="explanation-card card">
        <text class="explanation-text">{{resultData.explanation}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">🎯 类比一下</text>
      <view class="analogy-card card">
        <text class="analogy-text">{{resultData.analogy}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{resultData.examples && resultData.examples.length > 0}}">
      <text class="section-title">📝 举个例子</text>
      <view class="examples-card card">
        <view 
          class="example-item" 
          wx:for="{{resultData.examples}}" 
          wx:key="*this"
        >
          <text class="example-number">{{index + 1}}</text>
          <text class="example-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <text class="section-title">🔗 相关词汇</text>
      <view class="related-tags">
        <view 
          class="related-tag tag tag-primary" 
          wx:for="{{relatedTerms}}" 
          wx:key="*this"
          bindtap="onRelatedTap"
          data-term="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>
</view>
