<view class="page">
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading-card">
      <image class="loading-robot" src="/assets/home/hero-robot.png" mode="aspectFit" />
      <view class="loading-spinner"></view>
      <text class="loading-text">正在把它整理成大白话...</text>
    </view>
  </view>

  <view class="error-state" wx:elif="{{errorText}}">
    <view class="error-card">
      <image class="error-robot" src="/assets/home/hero-robot.png" mode="aspectFit" />
      <text class="error-title">暂时没有找到解释</text>
      <text class="error-text">{{errorText}}</text>
      <button class="error-action" bindtap="onReExplainTap">换个更简单的说法</button>
    </view>
  </view>

  <view class="result-content" wx:elif="{{resultData}}">
    <view class="title-card">
      <view class="title-copy">
        <text class="title-kicker">AI 已为你生成解释</text>
        <text class="title-text">{{resultData.title}}</text>
      </view>
    </view>

    <view class="explain-card main-card">
      <view class="card-header">
        <view>
          <text class="section-label">01</text>
          <text class="section-title">大白话解释</text>
        </view>
      </view>
      <text class="main-answer">{{resultData.professionalExplanation || resultData.summary}}</text>
      <view class="translation-box" wx:if="{{resultData.translation}}">
        <text class="translation-line" wx:if="{{resultData.translation.english}}">英文全称：{{resultData.translation.english}}</text>
        <text class="translation-line" wx:if="{{resultData.translation.chinese}}">中文翻译：{{resultData.translation.chinese}}</text>
      </view>
    </view>

    <view class="explain-card life-card" wx:if="{{resultData.currentLifeExample}}">
      <view class="card-header">
        <view>
          <text class="section-label">02</text>
          <text class="section-title">生活中的理解</text>
        </view>
        <button class="switch-example" wx:if="{{resultData.canSwitchExample}}" bindtap="onSwitchExampleTap">换一个例子</button>
      </view>

      <view class="story-box">
        <text class="story-title">{{resultData.currentLifeExample.title}}</text>
        <text class="story-content">{{resultData.currentLifeExample.content}}</text>
      </view>

      <view class="example-dots" wx:if="{{resultData.lifeExamples.length > 1}}">
        <view
          class="example-dot {{index === resultData.currentExampleIndex ? 'active' : ''}}"
          wx:for="{{resultData.lifeExamples}}"
          wx:key="index"
        ></view>
      </view>

      <view class="example-feedback">
        <text class="feedback-title">这个例子容易理解吗？</text>
        <view class="feedback-actions">
          <button class="feedback-btn" data-type="understood" bindtap="onLifeExampleFeedbackTap">👍 看懂了</button>
          <button class="feedback-btn" data-type="not_understood" bindtap="onLifeExampleFeedbackTap">👎 没看懂</button>
        </view>
      </view>
    </view>

    <view class="explain-card ai-card" wx:if="{{resultData.aiExample}}">
      <view class="card-header">
        <view>
          <text class="section-label">03</text>
          <text class="section-title">AI里面怎么用</text>
        </view>
      </view>
      <text class="section-text">{{resultData.aiExample}}</text>
    </view>

    <view class="bottom-actions">
      <button class="bottom-btn primary" bindtap="onReExplainTap">换个更简单的说法</button>
    </view>
  </view>

  <view class="error-state" wx:else>
    <view class="error-card">
      <image class="error-robot" src="/assets/home/hero-robot.png" mode="aspectFit" />
      <text class="error-title">暂时没有找到解释</text>
      <text class="error-text">请换一个问题试试</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
