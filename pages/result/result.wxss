/* 结果页样式 - Apple 设计风格 · 增强版 */

.page {
  min-height: 100vh;
  padding: 48rpx 44rpx 0;
  box-sizing: border-box;
}

.result-content {
  animation: fadeInUp 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* ============== 术语标题区 ============== */
.term-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 56rpx;
}

.term-title {
  flex: 1;
  font-size: 56rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1D1D1F 0%, #424245 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -1.2rpx;
  line-height: 1.15;
  margin-right: 24rpx;
}

.term-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  padding: 0;
}

/* ============== 内容区块 ============== */
.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  letter-spacing: -0.6rpx;
}

/* ============== 解释卡片 - 增强版 ============== */
.explanation-card {
  padding: 36rpx;
}

.explanation-text {
  font-size: 32rpx;
  color: #1D1D1F;
  line-height: 1.7;
  font-weight: 400;
  letter-spacing: -0.2rpx;
}

/* ============== 类比卡片 - 增强版 ============== */
.analogy-card {
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(0,122,255,0.08) 0%, rgba(88,86,214,0.08) 100%);
  border: 1rpx solid rgba(0, 122, 255, 0.08);
  position: relative;
}

.analogy-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 24rpx;
  right: 24rpx;
  height: 1rpx;
  background: linear-gradient(90deg, 
    rgba(0,122,255,0.1) 0%, 
    rgba(0,122,255,0.3) 50%, 
    rgba(0,122,255,0.1) 100%);
}

.analogy-text {
  font-size: 30rpx;
  color: #1D1D1F;
  line-height: 1.7;
  font-style: italic;
  letter-spacing: -0.2rpx;
}

/* ============== 示例卡片 - 增强版 ============== */
.examples-card {
  padding: 8rpx 0;
  overflow: hidden;
}

.example-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  transition: background 0.2s ease;
}

.example-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.example-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #007AFF 0%, #5856D6 100%);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.25);
}

.example-text {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  line-height: 1.6;
  padding-top: 6rpx;
  letter-spacing: -0.2rpx;
}

/* ============== 相关标签 ============== */
.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.related-tag {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  letter-spacing: -0.2rpx;
}

.related-tag:active {
  transform: scale(0.95);
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 140rpx;
}
