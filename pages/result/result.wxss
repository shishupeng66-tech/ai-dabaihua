.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 0;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 6%, rgba(255, 184, 64, 0.2) 0%, rgba(255, 184, 64, 0) 34%),
    radial-gradient(circle at 90% 20%, rgba(255, 138, 0, 0.12) 0%, rgba(255, 138, 0, 0) 30%),
    linear-gradient(180deg, #fff8f1 0%, #fffdf8 48%, #ffffff 100%);
  color: #1f1f1f;
}

button {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

button::after {
  border: none;
}

.result-content {
  animation: fadeIn 0.32s ease;
}

.loading-container,
.error-state {
  min-height: 78vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-card,
.error-card {
  width: 100%;
  padding: 44rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(241, 230, 214, 0.9);
  box-shadow: 0 28rpx 72rpx rgba(126, 82, 23, 0.1);
}

.loading-robot,
.error-robot {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 22rpx;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 6rpx solid rgba(255, 138, 0, 0.18);
  border-top-color: #ff8a00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text,
.error-text {
  margin-top: 20rpx;
  color: #6b6b6b;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.error-title {
  color: #1f1f1f;
  font-size: 38rpx;
  font-weight: 800;
}

.error-action {
  width: 260rpx;
  height: 84rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a00 0%, #ffb040 100%);
  font-size: 29rpx;
  font-weight: 800;
}

.title-card {
  position: relative;
  min-height: 250rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(241, 230, 214, 0.9);
  box-shadow:
    0 28rpx 72rpx rgba(126, 82, 23, 0.11),
    0 6rpx 18rpx rgba(126, 82, 23, 0.06);
  overflow: hidden;
}

.title-copy {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.title-kicker {
  display: inline-flex;
  max-width: 100%;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #8a4b00;
  background: #fff3df;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.title-text {
  display: -webkit-box;
  margin-top: 20rpx;
  color: #1f1f1f;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 900;
  word-break: break-word;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.title-visual {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.title-robot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 150rpx;
  height: 150rpx;
  z-index: 2;
}

.title-bubble {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 96rpx;
  height: 74rpx;
  z-index: 1;
}

.explain-card,
.learn-card {
  margin-top: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(241, 230, 214, 0.9);
  box-shadow: 0 20rpx 52rpx rgba(126, 82, 23, 0.08);
}

.main-card {
  background: linear-gradient(180deg, rgba(255, 250, 243, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.life-card {
  background: #ffffff;
}

.ai-card {
  background: #fffdf8;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.card-header.compact {
  margin-bottom: 18rpx;
}

.section-label {
  display: block;
  color: #ff8a00;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 900;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  color: #1f1f1f;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
}

.icon-action,
.switch-example {
  min-width: 144rpx;
  height: 58rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #8a4b00;
  background: #fff3df;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.icon-action.active {
  color: #ffffff;
  background: #8a4b00;
}

.main-answer {
  display: block;
  padding: 30rpx;
  border-radius: 28rpx;
  color: #1f1f1f;
  background: #ffffff;
  border: 1rpx solid #f1e6d6;
  font-size: 34rpx;
  line-height: 1.58;
  font-weight: 850;
  box-sizing: border-box;
  word-break: break-word;
}

.translation-box {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fffaf3;
  border: 1rpx solid rgba(255, 138, 0, 0.1);
}

.translation-line {
  display: block;
  color: #6b4b2b;
  font-size: 25rpx;
  line-height: 1.55;
  word-break: break-word;
}

.life-illustration {
  position: relative;
  height: 210rpx;
  margin-bottom: 22rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fff8f1 0%, #fffdf8 100%);
}

.life-woman {
  position: absolute;
  left: 20rpx;
  bottom: -6rpx;
  width: 172rpx;
  height: 172rpx;
  z-index: 2;
}

.life-robot {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  width: 154rpx;
  height: 154rpx;
  z-index: 2;
}

.life-bubble-orange {
  position: absolute;
  left: 214rpx;
  top: 34rpx;
  width: 118rpx;
  height: 86rpx;
  z-index: 3;
}

.life-bubble-white {
  position: absolute;
  right: 132rpx;
  top: 58rpx;
  width: 122rpx;
  height: 84rpx;
  opacity: 0.9;
  z-index: 1;
}

.life-coffee {
  position: absolute;
  left: 314rpx;
  bottom: 12rpx;
  width: 56rpx;
  height: 56rpx;
  z-index: 2;
}

.story-box {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffaf3;
  border: 1rpx solid rgba(255, 138, 0, 0.12);
  box-sizing: border-box;
}

.story-title {
  display: block;
  color: #1f1f1f;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 900;
  word-break: break-word;
}

.story-content,
.section-text {
  display: block;
  color: #4b4b4b;
  font-size: 29rpx;
  line-height: 1.68;
  word-break: break-word;
}

.story-content {
  margin-top: 14rpx;
}

.section-text {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #f1e6d6;
  box-sizing: border-box;
}

.small-robot {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.example-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.example-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #f1d2aa;
}

.example-dot.active {
  width: 34rpx;
  background: #ff8a00;
}

.example-feedback {
  width: 100%;
  max-width: 560rpx;
  margin: 24rpx auto 0;
  padding: 22rpx 20rpx;
  border-radius: 28rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(255, 138, 0, 0.1);
  box-sizing: border-box;
}

.feedback-title {
  display: block;
  color: #6b4b2b;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 800;
  text-align: center;
}

.feedback-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.feedback-btn {
  width: 220rpx;
  min-height: 62rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #8a4b00;
  background: #fff3df;
  font-size: 24rpx;
  font-weight: 850;
  box-sizing: border-box;
  white-space: nowrap;
}

.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.related-tag {
  min-width: 112rpx;
  min-height: 64rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #8a4b00;
  background: #fff3df;
  border: 1rpx solid rgba(255, 138, 0, 0.08);
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
  word-break: break-word;
}

.bottom-actions {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.bottom-btn {
  min-height: 78rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 850;
  box-sizing: border-box;
}

.bottom-btn.primary {
  width: 440rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a00 0%, #ffb040 100%);
  box-shadow: 0 14rpx 30rpx rgba(255, 138, 0, 0.22);
}

.bottom-btn.secondary {
  color: #8a4b00;
  background: #fff3df;
}

.icon-action:active,
.switch-example:active,
.feedback-btn:active,
.related-tag:active,
.bottom-btn:active,
.error-action:active {
  transform: scale(0.98);
}

.bottom-spacer {
  height: 96rpx;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
