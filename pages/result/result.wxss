/* 结果页面样式 - 清新极简风格 */

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.result-content {
  animation: fadeIn 0.4s ease;
}

.term-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.term-title {
  font-size: 48rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #1E293B 0%, #6366F1 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: -0.5rpx;
}

.term-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 0;
}

.section {
  margin-bottom: 28rpx;
}

.explanation-card {
  padding: 28rpx;
}

.explanation-text {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.7;
}

.analogy-card {
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(78, 205, 196, 0.1) 0%, rgba(68, 160, 141, 0.08) 100%);
  border: 1rpx solid rgba(78, 205, 196, 0.2);
}

.analogy-text {
  font-size: 28rpx;
  color: #0F766E;
  line-height: 1.6;
  font-style: italic;
  font-weight: 500;
}

.examples-card {
  padding: 16rpx 0;
}

.example-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 28rpx;
  gap: 16rpx;
}

.example-number {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
  flex-shrink: 0;
}

.example-text {
  flex: 1;
  font-size: 28rpx;
  color: #475569;
  line-height: 1.6;
}

.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.related-tag {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.bottom-spacer {
  height: 100rpx;
}
