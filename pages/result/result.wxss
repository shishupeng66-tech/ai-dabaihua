/* 结果页样式 - Apple 设计风格 */

.page {
  min-height: 100vh;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

.result-content {
  animation: fadeIn 0.4s ease;
}

/* ============== 术语标题 ============== */
.term-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.term-title {
  flex: 1;
  font-size: 52rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
  margin-right: 20rpx;
}

.term-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 0;
}

/* ============== 内容区块 ============== */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20rpx;
  letter-spacing: -0.3rpx;
}

/* ============== 解释卡片 ============== */
.explanation-card {
  padding: 32rpx;
}

.explanation-text {
  font-size: 30rpx;
  color: #1D1D1F;
  line-height: 1.6;
  font-weight: 400;
}

/* ============== 类比卡片 ============== */
.analogy-card {
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(0,122,255,0.08) 0%, rgba(88,86,214,0.08) 100%);
}

.analogy-text {
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.6;
  font-style: italic;
}

/* ============== 示例卡片 ============== */
.examples-card {
  padding: 8rpx 0;
  overflow: hidden;
}

.example-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
  gap: 20rpx;
}

.example-number {
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 122, 255, 0.12);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #007AFF;
  font-weight: 600;
  flex-shrink: 0;
}

.example-text {
  flex: 1;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.5;
  padding-top: 4rpx;
}

/* ============== 相关标签 ============== */
.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.related-tag {
  padding: 14rpx 26rpx;
  font-size: 26rpx;
}

/* ============== 底部留白 ============== */
.bottom-spacer {
  height: 120rpx;
}
