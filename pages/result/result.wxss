/* 结果页面样式 - 手绘笔记风格 */

.page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-doodle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-pencil {
  font-size: 80rpx;
  animation: pencil-write 0.8s ease-in-out infinite;
}

@keyframes pencil-write {
  0%, 100% { transform: rotate(-5deg) translateX(0); }
  50% { transform: rotate(5deg) translateX(20rpx); }
}

/* 结果内容 */
.result-content {
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 术语标题 */
.term-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.term-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.action-btn {
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

.action-btn.favorited {
  animation: heartBeat 0.3s ease;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 内容区块 */
.section {
  margin-bottom: 28rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

/* 解释卡片 */
.explanation-card {
  padding: 28rpx;
  position: relative;
  transform: rotate(-0.3deg);
}

.explanation-text {
  font-size: 28rpx;
  color: #2D2D2D;
  line-height: 1.7;
  font-weight: 400;
}

/* 类比卡片 */
.analogy-card {
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  transform: rotate(0.5deg);
}

.analogy-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.analogy-text {
  flex: 1;
  font-size: 26rpx;
  color: #1B5E20;
  line-height: 1.6;
  font-style: italic;
  font-weight: 500;
}

/* 例子卡片 */
.examples-card {
  padding: 20rpx 0;
  position: relative;
  transform: rotate(-0.5deg);
}

.example-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 28rpx;
  gap: 16rpx;
}

.example-number {
  width: 40rpx;
  height: 40rpx;
  background: rgba(3, 169, 244, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #01579B;
  font-weight: 700;
  flex-shrink: 0;
}

.example-text {
  flex: 1;
  font-size: 26rpx;
  color: #2D2D2D;
  line-height: 1.6;
}

/* 相关词汇 */
.related-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.related-tag {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.related-tag:active {
  transform: scale(0.95);
}

/* 底部留白 */
.bottom-spacer {
  height: 100rpx;
}
