.page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 184, 64, 0.2) 0%, rgba(255, 184, 64, 0) 34%),
    linear-gradient(180deg, #fff8f1 0%, #ffffff 100%);
  color: #1f1f1f;
}

.loading-container,
.error-state {
  min-height: 76vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  border: 6rpx solid rgba(255, 138, 0, 0.18);
  border-top-color: #ff8a00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text,
.error-text {
  margin-top: 24rpx;
  color: #6b6b6b;
  font-size: 29rpx;
  line-height: 1.6;
}

.error-title {
  color: #1f1f1f;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 900;
}

.simple-content {
  animation: fadeIn 0.28s ease;
}

.kicker {
  display: inline-flex;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #8a4b00;
  background: #fff3df;
  font-size: 24rpx;
  font-weight: 850;
}

.title {
  display: block;
  margin-top: 28rpx;
  color: #1f1f1f;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 950;
  word-break: break-word;
}

.note-card {
  margin-top: 34rpx;
  padding: 42rpx 34rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(241, 230, 214, 0.95);
  box-shadow: 0 24rpx 64rpx rgba(126, 82, 23, 0.1);
  box-sizing: border-box;
}

.note-text {
  display: block;
  color: #3f3f3f;
  font-size: 34rpx;
  line-height: 1.78;
  font-weight: 650;
  word-break: break-word;
  white-space: pre-wrap;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
