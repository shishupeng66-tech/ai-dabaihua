/* app.wxss - 清新极简风格 */

page {
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1E293B;
}

/* 全局容器 */
.container {
  padding: 0 32rpx;
  position: relative;
}

/* 卡片基础样式 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08), 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* 主按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 30rpx;
  padding: 24rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.25);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

/* 次按钮样式 */
.btn-secondary {
  background: #F1F5F9;
  color: #475569;
  border: none;
  border-radius: 20rpx;
  font-weight: 500;
  font-size: 26rpx;
  padding: 20rpx 32rpx;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #E2E8F0;
}

/* 输入框样式 */
.input-field {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1E293B;
  transition: all 0.25s ease;
}

.input-field:focus {
  border-color: #6366F1;
  background: #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(99, 102, 241, 0.1);
}

.input-field::placeholder {
  color: #94A3B8;
}

/* 大标题样式 */
.large-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1E293B;
  letter-spacing: -1rpx;
  line-height: 1.15;
}

/* 中标题 */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
  letter-spacing: -0.5rpx;
}

/* 小标题 */
.subtitle {
  font-size: 28rpx;
  color: #64748B;
  font-weight: 400;
  line-height: 1.5;
}

/* 章节标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 20rpx;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.tag-primary {
  background: rgba(99, 102, 241, 0.12);
  color: #6366F1;
}

.tag-secondary {
  background: #F1F5F9;
  color: #64748B;
}

/* 图标容器 */
.icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.icon-box-primary {
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(139, 92, 246, 0.1) 100%);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #E2E8F0, transparent);
  margin: 24rpx 0;
}

/* 加载动画 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E2E8F0;
  border-top-color: #6366F1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #64748B;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  color: #1E293B;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #94A3B8;
  line-height: 1.5;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.list-item:last-child {
  border-bottom: none;
}

/* 文字颜色系统 */
.text-primary {
  color: #1E293B;
}
.text-secondary {
  color: #64748B;
}
.text-tertiary {
  color: #94A3B8;
}
.text-accent {
  color: #6366F1;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: 40rpx;
}

/* 页面通用间距 */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* 淡入动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in {
  animation: fadeIn 0.4s ease;
}
