/* app.wxss - 手绘笔记风格 */

page {
  background: #FFF9E8;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI',
               'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
               sans-serif;
  color: #2D2D2D;
  position: relative;
}

/* 纸张纹理背景 */
page::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 28rpx,
      rgba(135, 206, 235, 0.15) 28rpx,
      rgba(135, 206, 235, 0.15) 29rpx
    );
  pointer-events: none;
  z-index: 0;
}

/* 笔记本装订线 */
page::after {
  content: '';
  position: fixed;
  top: 0;
  left: 60rpx;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(
    180deg,
    #FFB6C1 0%,
    #FFB6C1 8%,
    #98FB98 8%,
    #98FB98 16%,
    #87CEEB 16%,
    #87CEEB 24%,
    #DDA0DD 24%,
    #DDA0DD 32%,
    #F0E68C 32%,
    #F0E68C 40%,
    #FFB6C1 40%,
    #FFB6C1 48%,
    #98FB98 48%,
    #98FB98 56%,
    #87CEEB 56%,
    #87CEEB 64%,
    #DDA0DD 64%,
    #DDA0DD 72%,
    #F0E68C 72%,
    #F0E68C 80%,
    #FFB6C1 80%,
    #FFB6C1 88%,
    #98FB98 88%,
    #98FB98 96%,
    #87CEEB 96%,
    #87CEEB 100%
  );
  pointer-events: none;
  z-index: 1;
}

/* 便签卡片基础样式 */
.sticky-note {
  background: #FFFEF0;
  border-radius: 4rpx;
  box-shadow:
    2rpx 2rpx 8rpx rgba(0, 0, 0, 0.08),
    0 0 0 1rpx rgba(0, 0, 0, 0.03);
  position: relative;
  transition: all 0.2s ease;
}

.sticky-note:active {
  transform: translateY(-2rpx) rotate(0.5deg);
  box-shadow:
    4rpx 4rpx 16rpx rgba(0, 0, 0, 0.12),
    0 0 0 1rpx rgba(0, 0, 0, 0.03);
}

/* 黄色便签 - 主色调 */
.sticky-yellow {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFF59D 100%);
}

/* 粉色便签 */
.sticky-pink {
  background: linear-gradient(135deg, #FFECB3 0%, #FFE0B2 100%);
}

/* 蓝色便签 */
.sticky-blue {
  background: linear-gradient(135deg, #E1F5FE 0%, #B3E5FC 100%);
}

/* 绿色便签 */
.sticky-green {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

/* 紫色便签 */
.sticky-purple {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
}

/* 胶带效果 */
.tape {
  position: absolute;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(2rpx);
  transform: rotate(-2deg);
  z-index: 10;
}

.tape-top {
  top: -12rpx;
  left: 50%;
  width: 120rpx;
  margin-left: -60rpx;
}

.tape-corner {
  top: -8rpx;
  left: 20rpx;
  width: 80rpx;
}

/* 主按钮 - 马克笔风格 */
.btn-marker {
  background: linear-gradient(135deg, #FFD54F 0%, #FFCA28 100%);
  color: #5D4037;
  border: none;
  border-radius: 6rpx;
  font-weight: 600;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
  box-shadow:
    2rpx 2rpx 0 rgba(255, 143, 0, 0.3),
    4rpx 4rpx 8rpx rgba(0, 0, 0, 0.1);
  position: relative;
  transition: all 0.2s ease;
}

.btn-marker:active {
  transform: translateY(2rpx);
  box-shadow:
    1rpx 1rpx 0 rgba(255, 143, 0, 0.3),
    2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 次按钮 - 铅笔风格 */
.btn-pencil {
  background: #FFFFFF;
  color: #5D4037;
  border: 2rpx solid #E0E0E0;
  border-radius: 6rpx;
  font-weight: 500;
  font-size: 28rpx;
  padding: 18rpx 32rpx;
  box-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.btn-pencil:active {
  background: #F5F5F5;
  transform: translateY(1rpx);
  box-shadow: 1rpx 1rpx 2rpx rgba(0, 0, 0, 0.08);
}

/* 搜索框 - 笔记本风格 */
.notebook-input {
  background: #FFFEF8;
  border: none;
  border-bottom: 3rpx solid #FFD54F;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #2D2D2D;
  transition: all 0.2s ease;
}

.notebook-input:focus {
  border-bottom-color: #FFC107;
  background: #FFFDE7;
}

.notebook-input::placeholder {
  color: #BDBDBD;
  font-style: italic;
}

/* 大标题 - 马克笔风格 */
.marker-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #5D4037;
  letter-spacing: -1rpx;
  position: relative;
  display: inline-block;
}

.marker-title::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: -4rpx;
  right: -4rpx;
  height: 16rpx;
  background: rgba(255, 213, 79, 0.4);
  z-index: -1;
  transform: rotate(-0.5deg);
  border-radius: 2rpx;
}

/* 中标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 16rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 6rpx;
  background: #FF7043;
  border-radius: 50%;
}

/* 副标题 */
.subtitle {
  font-size: 26rpx;
  color: #8D6E63;
  font-weight: 400;
  line-height: 1.5;
  font-style: italic;
}

/* 标签系统 - 荧光笔风格 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.tag-yellow {
  background: rgba(255, 213, 79, 0.5);
  color: #5D4037;
}

.tag-pink {
  background: rgba(244, 143, 177, 0.5);
  color: #880E4F;
}

.tag-blue {
  background: rgba(129, 212, 250, 0.5);
  color: #01579B;
}

.tag-green {
  background: rgba(165, 214, 167, 0.5);
  color: #1B5E20;
}

/* 图标容器 - 圆形贴纸 */
.icon-sticker {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow:
    2rpx 2rpx 4rpx rgba(0, 0, 0, 0.1),
    0 0 0 1rpx rgba(0, 0, 0, 0.05);
}

.icon-yellow {
  background: linear-gradient(135deg, #FFF59D 0%, #FFEE58 100%);
}

.icon-pink {
  background: linear-gradient(135deg, #F8BBD9 0%, #F48FB1 100%);
}

.icon-blue {
  background: linear-gradient(135deg, #B3E5FC 0%, #81D4FA 100%);
}

.icon-green {
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
}

.icon-purple {
  background: linear-gradient(135deg, #E1BEE7 0%, #CE93D8 100%);
}

/* 分割线 - 手绘虚线 */
.doodle-divider {
  height: 2rpx;
  background: repeating-linear-gradient(
    90deg,
    #E0E0E0 0%,
    #E0E0E0 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
  margin: 24rpx 0;
}

/* 加载动画 - 铅笔涂写 */
.loading-doodle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-pencil {
  font-size: 60rpx;
  animation: pencil-write 0.8s ease-in-out infinite;
}

@keyframes pencil-write {
  0%, 100% { transform: rotate(-5deg) translateX(0); }
  50% { transform: rotate(5deg) translateX(20rpx); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8D6E63;
  font-style: italic;
}

/* 空状态 - 空白笔记 */
.empty-notebook {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  color: #5D4037;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-subtitle {
  font-size: 24rpx;
  color: #8D6E63;
  font-style: italic;
}

/* 文字颜色 */
.text-primary {
  color: #2D2D2D;
}

.text-secondary {
  color: #5D4037;
}

.text-tertiary {
  color: #8D6E63;
}

.text-accent {
  color: #FF7043;
}

/* 页面内容容器 */
.page-content {
  position: relative;
  z-index: 2;
  padding: 40rpx 32rpx 40rpx 80rpx;
}
